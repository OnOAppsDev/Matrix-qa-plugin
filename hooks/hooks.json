{
  "description": "Matrix QA safety guard: blocks git writes, application-source writes and .env access in Matrix QA repositories, keeps Figma read-only, and forces explicit QA engineer confirmation for approvals and changes to approved plans or existing automation.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*[Ff]igma.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
