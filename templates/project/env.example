# Copy to .env (never committed) and fill in locally. CI provides the same variables as secrets.
# Do not paste real values into this file.

# Environment to run against (a key of "environments" in matrix-qa.config.json)
MQA_ENV=qa
# Optional: override the environment's baseUrl, e.g. for a preview deployment
# MQA_BASE_URL=
# Optional: projects to run when --project is not given ("all" or a comma list); defaults to defaultProjects
# MQA_PROJECTS=
# Required only to run against an environment marked "protected": set it to that environment's name
# MQA_CONFIRM_PROTECTED=

# Test users (see tests/fixtures/users.ts)
MQA_USER_STANDARD_USERNAME=
MQA_USER_STANDARD_PASSWORD=
